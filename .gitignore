# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# superpowers
.superpowers/

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/gsc-key.json

# scraper scripts (local only)
scripts/scrapling-*.py
scripts/carfax-*.py
scripts/*scraper*
scripts/*crawl*
__pycache__/
*.pyc
